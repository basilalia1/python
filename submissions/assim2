import csv
from collections import Counter

total_bytes = Counter()

with open("exercise_connections.csv", "r") as f:
    reader = csv.DictReader(f)

    for row in reader:
        src_ip = row["src_ip"]
        bytes_transferred = int(row["bytes"])
        total_bytes[src_ip] += bytes_transferred

highest_ip, highest_bytes = total_bytes.most_common(1)[0]

print(f"Highest: {highest_ip} with {highest_bytes} bytes")

