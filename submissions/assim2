import hashlib  
import socket  

def port_status(host, port):
    """Check whether a TCP port is open on a host."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(1)
    try:
        sock.connect((host, port))
        return "open"
    except OSError:
        return "closed"
    finally:
        sock.close()


def quick_check(path, host, port):
    """Return {'sha256': ..., 'port_status': 'open'|'closed'}."""

    with open(path, "rb") as f:
        file_hash = hashlib.sha256(f.read()).hexdigest()

    port_result = port_status(host, port)

    return {"sha256": file_hash, "port_status": port_result}


print(quick_check("sample_file.txt", "127.0.0.1", 22))



